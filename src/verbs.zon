            .errors = .{
                .{ .code = "denied.agent_approval", .summary = "Only a person can allow or approve; an agent may deny, reject or cancel the turn. The request stays pending" },
                .{ .code = "not_found.agent", .summary = "No agent with this ID" },
                .{ .code = "not_found.request", .summary = "An agent has no such pending request" },
                .{ .code = "conflict.request_resolved", .summary = "A request was already answered or withdrawn" },
                .{ .code = "invalid_params.answer", .summary = "The answer does not fit a request's harness answers" },
