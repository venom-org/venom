                .{ .name = "answer", .summary = "The answer", .type = .{ .kind = .string }, .required = true },
                .{ .name = "state", .summary = "The agent's state", .type = .{ .kind = .string, .choices = .{ "queued", "running", "needs_you", "failed", "settled", "handed_over", "archived" } }, .required = true },
            } },
            .errors = .{
                .{ .code = "denied.agent_approval", .summary = "Only a person can allow or approve; an agent may deny, reject or cancel the turn. The request stays pending" },
                .{ .code = "not_found.agent", .summary = "No agent with this ID" },
                .{ .code = "not_found.request", .summary = "The agent has no such pending request" },
                .{ .code = "conflict.request_resolved", .summary = "The request was already answered or withdrawn" },
                .{ .code = "invalid_params.answer", .summary = "The answer does not fit the request's kind or the harness's answers" },
            },
            .grant = .write,
            .examples = .{.{ .params = .{ .agent = "a2", .answer = "allow_once" }, .result = .{ .agent = "a2", .request = "r1", .answer = "allow_once", .state = "running" } }},
        },

        .{
            .name = "inbox.batch",
