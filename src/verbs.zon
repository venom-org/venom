            },
            .result = .{ .kind = .object, .fields = .{
                .{ .name = "grants", .summary = "Standing grants, oldest first", .type = .{ .kind = .array, .items = .{ .kind = .object, .fields = .{
                    .{ .name = "workspace", .summary = "Workspace path", .type = .{ .kind = .string }, .required = true },
                    .{ .name = "grant", .summary = "The grant, e.g. exec:zig or edit:src/proto.zig", .type = .{ .kind = .string }, .required = true },
                    .{ .name = "agent", .summary = "The agent whose approval recorded it", .type = .{ .kind = .string }, .required = true },
                    .{ .name = "request", .summary = "The request that recorded it", .type = .{ .kind = .string }, .required = true },
                    .{ .name = "at", .summary = "Recorded at, ms since the Unix epoch", .type = .{ .kind = .integer }, .required = true },
                } } }, .required = true },
            } },
            .grant = .read,
            .examples = .{.{ .params = .{}, .result = .{ .grants = .{.{ .workspace = "/home/me/venom-org", .grant = "exec:zig", .agent = "a2", .request = "r1", .at = 1794000000000 }} } }},
        },

        .{
            .name = "always.revoke",
            .summary = "Revoke a standing allow-always grant; matching approvals ask again",
            .params = .{
                .{ .name = "workspace", .summary = "Workspace path, as always list shows it", .type = .{ .kind = .string }, .required = true },
                .{ .name = "grant", .summary = "The grant, e.g. exec:zig", .type = .{ .kind = .string }, .required = true },
            },
            .result = .{ .kind = .object, .fields = .{
                .{ .name = "workspace", .summary = "Workspace path", .type = .{ .kind = .string }, .required = true },
                .{ .name = "grant", .summary = "The revoked grant", .type = .{ .kind = .string }, .required = true },
            } },
            .errors = .{
                .{ .code = "not_found.grant", .summary = "No such standing grant" },
            },
            .grant = .write,
            .examples = .{.{ .params = .{ .workspace = "/home/me/venom-org", .grant = "exec:zig" }, .result = .{ .workspace = "/home/me/venom-org", .grant = "exec:zig" } }},
        },

        .{
            .name = "inbox.snooze",
            .summary = "Hide an inbox item for a while (15m by default)",
            .params = .{
                .{ .name = "agent", .summary = "Agent ID", .type = .{ .kind = .string }, .required = true },
                .{ .name = "item", .summary = "Request ID, or failed, limit or review; the agent's most urgent item when omitted", .type = .{ .kind = .string } },
                .{ .name = "duration", .summary = "How long, e.g. 15m or 2h", .type = .{ .kind = .string }, .default = "15m" },
            },
            .result = .{ .kind = .object, .fields = .{
                .{ .name = "agent", .summary = "Agent ID", .type = .{ .kind = .string }, .required = true },
                .{ .name = "item", .summary = "The snoozed item", .type = .{ .kind = .string }, .required = true },
                .{ .name = "until", .summary = "Hidden until, ms since the Unix epoch", .type = .{ .kind = .integer }, .required = true },
            } },
            .errors = .{
                .{ .code = "not_found.agent", .summary = "No agent with this ID" },
                .{ .code = "not_found.item", .summary = "The agent has no such inbox item" },
                .{ .code = "invalid_params.duration", .summary = "Not a duration such as 15m" },
            },
            .grant = .write,
            .examples = .{.{ .params = .{ .agent = "a2" }, .result = .{ .agent = "a2", .item = "r1", .until = 1794000900000 } }},
        },

        .{
            .name = "tui.hold",
            .summary = "Hold the daemon for a venom TUI: while any hold lasts, an on-demand daemon keeps running, and it stops 5 s after the last one ends. venom's TUI sends it on every connect; only the owner and person principals may hold. Agents, hooks and scripts never need it",
            .params = .{},
            .streams = true,
            .item = .{ .kind = .object, .fields = .{
                .{ .name = "lifetime", .summary = "The daemon's latched lifetime", .type = .{ .kind = .string, .choices = .{ "persistent", "on-demand" } }, .required = true },
                .{ .name = "origin", .summary = "Who started the daemon", .type = .{ .kind = .string, .choices = .{ "serve", "interactive" } }, .required = true },
                .{ .name = "phase", .summary = "The daemon's lifetime state", .type = .{ .kind = .string, .choices = .{ "awaiting_first_client", "active", "lingering", "stopping" } }, .required = true },
                .{ .name = "clients", .summary = "Holds the daemon counts, this one included", .type = .{ .kind = .integer, .min = 0 }, .required = true },
                .{ .name = "others", .summary = "Holds that do not end with the caller: the caller's own and those bound below its process do not count", .type = .{ .kind = .integer, .min = 0 }, .required = true },
            } },
            .result = .{ .kind = .object, .fields = .{} },
            .errors = .{
                .{ .code = "denied.tui_hold", .summary = "Only the owner and person principals may hold the daemon" },
                .{ .code = "denied.revoked", .summary = "The holder's principal was revoked or expired" },
                .{ .code = "unavailable.shutdown", .summary = "The daemon is stopping" },
            },
            .grant = .read,
        },
    },
}
