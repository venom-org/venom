        .{
            .name = "inbox.list",
            .summary = "List what needs a human: blocking kinds first (approval, question, plan, failed, limit), then review; oldest first",
            .params = .{
                .{ .name = "snoozed", .summary = "Include snoozed items", .type = .{ .kind = .boolean }, .default = false },
            },
            .result = .{ .kind = .object, .fields = .{
                .{ .name = "items", .summary = "Inbox items, most urgent first", .type = .{ .kind = .array, .items = .{ .kind = .object, .fields = .{
                    .{ .name = "agent", .summary = "Agent ID", .type = .{ .kind = .string }, .required = true },
                    .{ .name = "kind", .summary = "Attention kind", .type = .{ .kind = .string, .choices = .{ "approval", "question", "plan", "failed", "limit", "review" } }, .required = true },
                    .{ .name = "age_s", .summary = "Seconds since the item appeared", .type = .{ .kind = .integer, .min = 0 }, .required = true },
                    .{ .name = "reason", .summary = "What the agent asks, or why it needs you", .type = .{ .kind = .string }, .required = true },
                    .{ .name = "item", .summary = "Item ID: the request ID, or the kind for failed, limit and review", .type = .{ .kind = .string }, .required = true },
                    .{ .name = "request", .summary = "Request ID (approval, question, plan)", .type = .{ .kind = .string } },
                    .{ .name = "blocking", .summary = "The agent waits on a human", .type = .{ .kind = .boolean }, .required = true },
                    .{ .name = "level", .summary = "Attention level: urgent, warn or info", .type = .{ .kind = .string, .choices = .{ "urgent", "warn", "info" } }, .required = true },
                    .{ .name = "title", .summary = "The agent's title", .type = .{ .kind = .string }, .required = true },
                    .{ .name = "state", .summary = "The agent's state", .type = .{ .kind = .string, .choices = .{ "queued", "running", "needs_you", "failed", "settled", "handed_over", "archived" } }, .required = true },
                    .{ .name = "stale", .summary = "The harness process that asked is gone; answering resumes the agent", .type = .{ .kind = .boolean }, .required = true },
                    .{ .name = "answers", .summary = "Answers the harness accepts (approval); empty: any", .type = .{ .kind = .array, .items = .{ .kind = .string } }, .required = true },
                    .{ .name = "grant", .summary = "The narrowest grant allow_always records, e.g. exec:zig (approval)", .type = .{ .kind = .string } },
                    .{ .name = "outside_scope", .summary = "A write outside the agent's scope, by an edit or a command: always asked, never answered by an allow-always grant (approval)", .type = .{ .kind = .boolean }, .required = true },
                    .{ .name = "options", .summary = "What a question offers, per question: id (q1, q2, … by position, the key of the answer's args), the question's text and its option labels in order; 1-9 pick one", .type = .{ .kind = .array, .items = .{ .kind = .object, .fields = .{
                        .{ .name = "id", .summary = "q1, q2, … by position", .type = .{ .kind = .string }, .required = true },
                        .{ .name = "question", .summary = "The question's text", .type = .{ .kind = .string }, .required = true },
                        .{ .name = "labels", .summary = "Option labels, in the order the harness lists them", .type = .{ .kind = .array, .items = .{ .kind = .string } }, .required = true },
                        .{ .name = "free_text", .summary = "The harness takes a typed answer besides the labels: an answer to this question may be any one string", .type = .{ .kind = .boolean }, .required = true },
                        .{ .name = "labels_omitted", .summary = "Some of the harness's labels are not listed (too many, not plain, over the size bound): the answer is not checked against labels", .type = .{ .kind = .boolean }, .required = true },
                    } } }, .required = true },
                    .{ .name = "snoozed_until", .summary = "Snoozed until, ms since the Unix epoch", .type = .{ .kind = .integer } },
                    .{ .name = "resets_at", .summary = "When a usage limit resets, RFC 3339 UTC (limit, when the harness said)", .type = .{ .kind = .string } },
                    .{ .name = "away", .summary = "Waiting in the harness's own TUI while handed over: answered there, focus its split", .type = .{ .kind = .boolean }, .required = true },
                    .{ .name = "context", .summary = "Text of the agent's last turns, oldest first", .type = .{ .kind = .array, .items = .{ .kind = .object, .fields = .{
                        .{ .name = "turn", .summary = "Turn ID", .type = .{ .kind = .string }, .required = true },
                        .{ .name = "text", .summary = "Message text", .type = .{ .kind = .string }, .required = true },
                    } } }, .required = true },
                } } }, .required = true },
            } },
            .grant = .read,
            .examples = .{.{ .params = .{}, .result = .{ .items = .{} } }},
        },

        .{
            .name = "inbox.answer",
            .summary = "Answer an agent's pending request (approval, question or plan)",
            .params = .{
                .{ .name = "agent", .summary = "Agent ID", .type = .{ .kind = .string }, .required = true },
                .{ .name = "answer", .summary = "approval: allow_once, allow_always (keeps the request's grant for the workspace), allow_edited, deny or cancel_turn; plan: approve, reject or cancel_turn; question: the reply. A question that takes labels only needs one of its listed labels (also in args, by question id); one that takes a typed answer accepts any string; one whose options were cut cannot be answered here, only in the harness", .type = .{ .kind = .string }, .required = true },
                .{ .name = "request", .summary = "Request ID; the agent's oldest pending request when omitted", .type = .{ .kind = .string } },
                .{ .name = "reason", .summary = "Deny reason or reject feedback; reaches the model", .type = .{ .kind = .string } },
                .{ .name = "args", .summary = "JSON object: edited arguments (allow_edited) or picks per question", .type = .{ .kind = .string } },
            },
            .result = .{ .kind = .object, .fields = .{
